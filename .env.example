# Copy this file to .env.local for local development, and add the same
# names/values in Netlify under Site settings -> Environment variables.
# See README.md for a full, non-technical walkthrough.

# Web search provider used to resolve competitor brand names to real domains
# and to find affiliate signals about them.
# Required. Get a key from https://serper.dev/
SEARCH_PROVIDER=serper
SERPER_API_KEY=

# LLM used to classify search results as real affiliate evidence.
# Required. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Optional: adds YouTube video/channel results to the scan. Without this,
# the scan still works using web search alone.
# Get a key from https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Optional: adds public Instagram/TikTok results via Apify. NOTE: as of this
# version, Instagram/TikTok are NOT called by the live scan even if this is
# set -- Apify's synchronous actor-run calls were the confirmed cause of
# production timeouts, and there's no background-job infrastructure yet to
# run them out of the request/response cycle safely. The provider code is
# intact and ready to be re-enabled once that exists.
# Get a token from https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# Advanced: override which Apify Actor is used for each platform. Leave
# blank to use the built-in defaults.
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=

# Optional: adds OpenAI Web Search results (via the Responses API's built-in
# web_search tool) to the scan, alongside Serper. Without this, the scan
# still works using the other sources.
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: looks up a business email for the strongest verified candidates.
# Without this, results simply show "Contact: Coming soon".
# Get a key from https://hunter.io/api-keys
HUNTER_API_KEY=

# Set to "true" only for local demos when the keys above aren't configured
# yet. Returns clearly-labeled fake candidates instead of running a real
# scan. Ignored in production regardless of this value.
PARTNRA_MOCK_MODE=false

# Stripe subscription billing. Without these, the "Continue to checkout"
# button in the plan-selection modal shows a clean "not open yet" message
# instead of pretending to work.
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Get from https://dashboard.stripe.com/webhooks after creating an endpoint
# pointed at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# One Price ID per plan, from https://dashboard.stripe.com/products
# (create a recurring monthly Price on each product, then copy its ID)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
