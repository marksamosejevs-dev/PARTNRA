# Copy this file to .env.local for local development, and add the same
# names/values in Netlify under Site settings -> Environment variables.
# See README.md for a full, non-technical walkthrough.

# Web search provider used to find affiliate signals about a competitor.
# Get a key from https://serper.dev/
SEARCH_PROVIDER=serper
SERPER_API_KEY=

# LLM used to classify search results as real affiliate evidence.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Set to "true" only for local demos when the keys above aren't configured
# yet. Returns clearly-labeled fake candidates instead of running a real
# scan. Leave unset (or "false") in production.
PARTNRA_MOCK_MODE=false
